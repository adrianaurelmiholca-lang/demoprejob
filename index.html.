        info.innerHTML = `<strong>${details[role].title}</strong><p>${details[role].text}</p>`;
    }

    // DemoPREJOB v0.4 — logică simplă, vizibilă și controlată
    let activeDemoPath = null;
    let demoStep = 0;
    let selectedAnswers = [];
    let demoTimers = [];

    const demoPaths = {
      gaming: {
        name: 'Gaming și strategie',
        questions: [
          { text: 'Ce îți place cel mai mult în gaming?', answers: ['Strategia', 'Colaborarea', 'Povestea'] },
          { text: 'Ce faci de obicei când apare o problemă?', answers: ['Caut soluții', 'Coordonez echipa', 'Încerc o idee nouă'] }
        ],
        hypotheses: ['planificare și rezolvare de probleme', 'colaborare și adaptare'],
        unknowns: ['dacă aceste preferințe apar și în afara jocurilor', 'cât de constant este interesul'],
        next: 'Testează un proiect de echipă în care trebuie să planifici și să explici o soluție.',
        rejected: 'Gaming-ul arată că ți se potrivește IT-ul.',
        accepted: 'Gaming-ul poate oferi indicii despre ce tip de activități îți plac; merită verificat și în contexte reale.'
      },
      voluntariat: {
        name: 'Voluntariat',
        questions: [
          { text: 'Ce ai făcut concret în activitatea de voluntariat?', answers: ['Am organizat', 'Am lucrat cu oamenii', 'Am executat sarcini practice'] },
          { text: 'Ce ți-a plăcut cel mai mult?', answers: ['Organizarea', 'Interacțiunea', 'Rezultatul obținut'] }
        ],
        hypotheses: ['responsabilitate și organizare', 'comunicare și implicare socială'],
        unknowns: ['ce tip de rol ți se potrivește în activități diferite', 'dacă preferința se menține în timp'],
        next: 'Participă la încă o activitate și observă ce rol alegi spontan.',
        rejected: 'Voluntariatul arată că ai profil de lider.',
        accepted: 'Experiența de voluntariat oferă indicii despre activitățile și responsabilitățile pe care le preferi.'
      },
      tehnologie: {
        name: 'Tehnologie',
        questions: [
          { text: 'Ce faci concret atunci când spui că îți place tehnologia?', answers: ['Construiesc', 'Repar', 'Programez', 'Explic altora'] },
          { text: 'Ce parte îți place mai mult?', answers: ['Logica', 'Creativitatea', 'Utilitatea', 'Lucrul cu oamenii'] }
        ],
        hypotheses: ['curiozitate tehnică și învățare prin testare', 'rezolvare de probleme'],
        unknowns: ['nivelul actual de experiență', 'ce tip de proiect menține interesul'],
        next: 'Realizează un proiect tehnic mic și notează ce etapă ți-a plăcut cel mai mult.',
        rejected: 'Dacă îți place tehnologia, trebuie să alegi programarea.',
        accepted: 'Interesul pentru tehnologie poate lua forme diferite; următorul pas este să testezi activități concrete.'
      }
    };

    function scheduleDemo(fn, delay){
      const id = setTimeout(() => {
        demoTimers = demoTimers.filter(x => x !== id);
        fn();
      }, delay);
      demoTimers.push(id);
    }

    function clearDemoTimers(){
      demoTimers.forEach(clearTimeout);
      demoTimers = [];
    }

    function addMessage(text, side){
      const win = document.getElementById('chatWindow');
      const div = document.createElement('div');
      div.className = `message msg-${side}`;
      div.textContent = text;
      win.appendChild(div);
      win.scrollTop = win.scrollHeight;
    }

    function showFreeInput(){
      addMessage('Scrie doar activitatea sau domeniul pe care vrei să-l explorezi. Nu introduce nume, date de contact, informații medicale sau alte date personale. În acest demo, textul nu este transmis și poate fi asociat doar cu câteva trasee prestabilite.', 'alira');
      document.getElementById('freeInputBox').classList.remove('hidden');
      document.getElementById('userInput').focus();
    }

    function submitFreeInput(){
      const input = document.getElementById('userInput');
      const text = input.value.trim();
      if(!text) return;
      addMessage(text, 'user');
      input.value = '';
      const low = text.toLowerCase();

      if(low.includes('renunț') || low.includes('abandonez școala') || low.includes('nu mai văd rostul școlii')){
        triggerPODS();
        return;
      }

      let mapped = null;
      if(low.includes('joc') || low.includes('gaming')) mapped = 'gaming';
      else if(low.includes('voluntar') || low.includes('ajut')) mapped = 'voluntariat';
      else if(low.includes('tehnolog') || low.includes('calculator') || low.includes('program')) mapped = 'tehnologie';

      if(!mapped){
        addMessage('În această versiune demonstrativă nu pot analiza liber orice text. Alege Gaming, Voluntariat sau scrie Tehnologie.', 'alira');
        return;
      }

      addMessage(`În această demonstrație, am asociat mesajul tău cu traseul „${demoPaths[mapped].name}”.`, 'alira');
      startDemoPath(mapped, true);
    }

    function startDemoPath(pathKey, fromFreeText = false){
      if(!demoPaths[pathKey]) return;
      resetDemo(false);
      activeDemoPath = pathKey;
      demoStep = 0;
      selectedAnswers = [];
      document.getElementById('quickReplies').classList.add('hidden');
      document.getElementById('freeInputBox').classList.add('hidden');
      if(!fromFreeText) addMessage(`Aș vrea să explorez: ${demoPaths[pathKey].name}.`, 'user');
      askDemoQuestion();
    }

    function askDemoQuestion(){
      const path = demoPaths[activeDemoPath];
      if(demoStep >= path.questions.length){
        finishDemo();
        return;
      }
      scheduleDemo(() => {
        const q = path.questions[demoStep];
        addMessage(q.text, 'alira');
        const wrap = document.createElement('div');
        wrap.className = 'quick-replies';
        q.answers.forEach(answer => {
          const btn = document.createElement('button');
          btn.className = 'reply-btn';
          btn.textContent = answer;
          btn.onclick = () => {
            addMessage(answer, 'user');
            selectedAnswers.push(answer);
            wrap.remove();
            demoStep++;
            updateDemoStages();
            askDemoQuestion();
          };
          wrap.appendChild(btn);
        });
        document.getElementById('chatWindow').appendChild(wrap);
        document.getElementById('chatWindow').scrollTop = document.getElementById('chatWindow').scrollHeight;
      }, 450);
    }

    function setStage(id, html){
      const el = document.getElementById(id);
      el.classList.add('active');
      el.querySelector('span').innerHTML = html;
    }

    function updateDemoStages(){
      const path = demoPaths[activeDemoPath];
      setStage('stage1', `<strong>${path.name}</strong>${selectedAnswers.length ? ' · ' + selectedAnswers.join(' · ') : ''}`);
      if(selectedAnswers.length >= 1){
        setStage('stage2', 'Ce parte a activității îți place și în ce alte contexte apare această preferință?');
      }
      if(selectedAnswers.length >= 2){
        setStage('stage3', '<ul>' + path.hypotheses.map(x => `<li>${x}</li>`).join('') + '</ul>');
        setStage('stage4', '<ul>' + path.unknowns.map(x => `<li>${x}</li>`).join('') + '</ul>');
        setStage('stage5', path.next);
      }
    }

    function finishDemo(){
      const path = demoPaths[activeDemoPath];
      scheduleDemo(() => {
        addMessage('Am structurat câteva ipoteze de explorare. Nu sunt un verdict și nu aleg în locul tău.', 'alira');
        const codex = document.getElementById('codexBox');
        codex.classList.add('active');
        codex.innerHTML = `<strong>CODEX — regulile fundamentale PREJOB</strong><br><span>Blochează verdictele și formulările prea categorice.</span><br><strong>Exemplu de formulare respinsă de CODEX:</strong><br><s>${path.rejected}</s><br><strong>Formulare permisă:</strong> ${path.accepted}`;

        const role = document.getElementById('roleBadge').textContent;
        const result = document.getElementById('demoResult');
        result.classList.add('active');
        const roleLine = role === 'Investitor'
          ? 'Pentru investitor: acest traseu demonstrează separarea dintre conversație, structurare logică, guvernanță și validare umană.'
          : role === 'Consilier'
          ? 'Pentru consilier: rezultatul este o bază de dialog și verificare, nu o concluzie profesională.'
          : 'Următorul pas este o activitate concretă și o discuție cu un consilier, profesor sau părinte.';
        result.innerHTML = `
          <h3>Ce demonstrează acest traseu</h3>
          <div class="demo-result-grid">
            <div class="demo-result-card"><strong>Observații</strong>${selectedAnswers.join(' · ')}</div>
            <div class="demo-result-card"><strong>Ipoteze prudente</strong>${path.hypotheses.join('; ')}</div>
            <div class="demo-result-card"><strong>Ce nu știm încă</strong>${path.unknowns.join('; ')}</div>
            <div class="demo-result-card"><strong>Ce poți testa</strong>${path.next}</div>
          </div>
          <p style="margin-bottom:0"><strong>${roleLine}</strong></p>
          <div class="demo-actions">
            <button class="again" onclick="resetDemo(true)">Reia demonstrația</button>
            <button class="roles" onclick="openRoles()">Schimbă perspectiva</button>
          </div>`;
      }, 550);
    }

    function triggerPODS(){
      clearDemoTimers();
      document.getElementById('quickReplies').classList.add('hidden');
      document.getElementById('freeInputBox').classList.add('hidden');
      addMessage('Ceea ce spui este important și nu trebuie redus la o alegere de carieră. În acest scenariu demonstrativ, PREJOB oprește explorarea obișnuită și recomandă să discuți cu un adult de încredere sau cu un specialist potrivit situației. Demo-ul nu evaluează și nu diagnostichează.', 'alira');
      const piap = document.getElementById('piapBox');
      piap.classList.add('active');
      piap.innerHTML = '<strong>PODS — Protocol de Oprire și Direcționare către Sprijin</strong><br>Situația depășește limitele orientării educaționale și profesionale. PREJOB oprește traseul standard și recomandă sprijin uman adecvat. Demo-ul nu evaluează, nu diagnostichează, nu monitorizează utilizatorul și nu contactează automat nicio terță persoană. În produsul real, astfel de fluxuri vor fi activate numai după validare juridică, DPO și metodologică.';
      setStage('stage1', 'Scenariu sensibil recunoscut printr-o regulă prestabilită.');
      setStage('stage5', 'Oprirea explorării și orientarea către sprijin uman.');
      const result = document.getElementById('demoResult');
      result.classList.add('active');
      result.innerHTML = `<h3>Explorarea profesională a fost oprită</h3><p>Acesta este un exemplu prestabilit despre cum PODS oprește traseul standard și recomandă sprijin uman. Demo-ul nu transmite notificări și nu contactează automat nicio persoană.</p><div class="demo-actions"><button class="again" onclick="resetDemo(true)">Reia demonstrația</button></div>`;
    }

    function resetDemo(shouldScroll = false){
      clearDemoTimers();
      activeDemoPath = null;
      demoStep = 0;
      selectedAnswers = [];
      const role = document.getElementById('roleBadge')?.textContent || 'Elev / Student';
      const roleIntro = role === 'Părinte'
        ? 'Salut, eu sunt ALIRA. În această demonstrație, te ajut să observi cum poți susține fără să decizi în locul tânărului.'
        : role === 'Consilier'
        ? 'Salut, eu sunt ALIRA. În această demonstrație, structurez observații pentru dialog și validare profesională.'
        : role === 'Investitor'
        ? 'Salut, eu sunt ALIRA. Această demonstrație arată logica PREJOB, nu un produs AI deja construit.'
        : 'Salut, eu sunt ALIRA. Sunt aici să te ajut să observi mai bine și să-ți pui întrebările potrivite. Acesta este un demo de explorare, nu o evaluare psihologică. Nu îți dau un verdict.';
      document.getElementById('chatWindow').innerHTML = `
        <div class="message msg-alira">${roleIntro}</div>
        <div class="message msg-alira">Cu ce activitate ai vrea să începem?</div>
        <div class="quick-replies" id="quickReplies">
          <button class="reply-btn" onclick="startDemoPath('gaming')">Gaming și strategie</button>
          <button class="reply-btn" onclick="startDemoPath('voluntariat')">Voluntariat</button>
          <button class="reply-btn" onclick="showFreeInput()">Altceva — vreau să scriu eu</button>
        </div>`;
      document.getElementById('freeInputBox').classList.add('hidden');
      document.querySelectorAll('.solon-stage').forEach(x => x.classList.remove('active'));
      document.getElementById('stage1').querySelector('span').textContent = 'Aștept răspunsul transmis prin ALIRA.';
      document.getElementById('stage2').querySelector('span').textContent = 'Aștept clarificări despre activitate și context.';
      document.getElementById('stage3').querySelector('span').textContent = 'Ipotezele vor apărea aici, fără scoruri.';
      document.getElementById('stage4').querySelector('span').textContent = 'Limitele și necunoscutele rămân vizibile.';
      document.getElementById('stage5').querySelector('span').textContent = 'Un test mic și o conversație umană.';
      document.getElementById('codexBox').classList.remove('active');
      document.getElementById('piapBox').classList.remove('active');
      document.getElementById('demoResult').classList.remove('active');
      if(shouldScroll) scrollToId('demo');
    }

    


    const roleDescriptions = {
      'Elev / Student': 'experiența de explorare personală, de la interese și activități la ipoteze educaționale.',
      'Părinte': 'modul în care familia poate susține procesul fără să decidă în locul tânărului.',
      'Profesor / Diriginte': 'observații școlare transformate în întrebări și contexte de explorare.',
      'Consilier': 'ipoteze structurate, limite clare și escaladare către intervenția umană.',
      'Companie / Partener': 'conectarea competențelor emergente cu activități și contexte din economia reală.',
      'Instituție / Decident': 'date agregate, nevoi regionale și puncte de intervenție instituțională.',
      'Investitor': 'valoarea sistemică, diferențiatorii, experiența produsului și potențialul de scalare.'
    };

    function openRoles(){ document.getElementById('roleOverlay').classList.remove('hidden'); }
    function selectRole(role){
      document.getElementById('roleOverlay').classList.add('hidden');
      document.getElementById('roleBadge').textContent = role;
      document.getElementById('roleNote').innerHTML = `<strong>Perspectivă activă:</strong> ${role} — ${roleDescriptions[role]}`;
      localStorage.setItem('prejobRole', role);
      if(role === 'Investitor' || role === 'Companie / Partener' || role === 'Instituție / Decident'){
        document.querySelector('.eyebrow').textContent = 'Demo unic · Perspectivă ' + role;
      } else {
        document.querySelector('.eyebrow').textContent = 'Demo PREJOB · Explorare ghidată 2026';
      }
      if(document.getElementById('chatWindow')) resetDemo(false);
    }

    function startGuidedDemo(){
      selectRole('Investitor');
      scrollToId('ecosistem');
      updateMap('implicati');
      setTimeout(()=>updateMap('decidenti'), 1300);
      setTimeout(()=>updateMap('beneficiari'), 2600);
      setTimeout(()=>scrollToId('demo'), 3900);
    }

    window.addEventListener('DOMContentLoaded', ()=>{
      const saved = localStorage.getItem('prejobRole');
      if(saved){ selectRole(saved); }
      else { document.getElementById('roleOverlay').classList.remove('hidden'); }
      updateMap('implicati');
    });

</script>

