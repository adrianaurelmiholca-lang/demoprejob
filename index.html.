<!doctype html>
<html lang="ro">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>DemoPREJOB v0.9 — Ecosistem, Radar și Consultanță</title>
<style>
:root {
    --navy: #0B2E4F;
    --navy2: #123B63;
    --ink: #102033;
    --muted: #66788b;
    --blue: #1d73be;
    --blue2: #4ba3e3;
    --ice: #eaf6ff;
    --white: #fff;
    --line: #d8e5ef;
    --green: #18a474;
    --gold: #f1a936;
    --red: #e55757;
    --shadow: 0 18px 55px rgba(7,28,49,.14);
    --radius: 16px;
}

* { box-sizing: border-box; }
html { scroll-behavior: smooth; }
body { 
    margin: 0; 
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; 
    color: var(--ink); 
    background: #f8fbff; 
    line-height: 1.6;
}
button, input { font: inherit; }
a { text-decoration: none; color: inherit; }

/* Topbar */
.topbar { 
    position: sticky; 
    top: 0; 
    z-index: 100; 
    background: rgba(7, 28, 49, 0.95); 
    backdrop-filter: blur(12px); 
    color: #fff; 
    border-bottom: 1px solid rgba(255,255,255,0.1); 
}
.nav { 
    max-width: 1480px; 
    margin: auto; 
    padding: 10px 18px; 
    display: flex; 
    align-items: center; 
    justify-content: space-between;
}
.brand { display: flex; align-items: center; gap: 14px; font-weight: 800; letter-spacing: 0.05em; }
.brand img { width: 54px; height: 54px; border-radius: 12px; object-fit: contain; background: #fff; padding: 5px; border: 2px solid #fff; box-shadow: 0 0 0 2px rgba(75,163,227,.55), 0 8px 20px rgba(0,0,0,.22); }
.brand div { line-height: 1.2; }
.brand small { display: block; font-weight: 500; color: #b9d8ee; font-size: 0.7rem; letter-spacing: 0; text-transform: none; }
.brand-name{font-size:1.08rem;letter-spacing:.035em}
.prejob-accent{color:#f3a83b;font-weight:900}
.sgp-link{display:inline-flex;align-items:center;justify-content:center;padding:8px 12px;border-radius:10px;border:1px solid rgba(243,168,59,.78);color:#fff;font-weight:800;font-size:13px;white-space:nowrap}
.sgp-link:hover{background:rgba(243,168,59,.16)}
.demo-wordmark{font-weight:900;letter-spacing:.02em}
.demo-wordmark .prejob-accent{color:#f3a83b}
.btn-sgp{background:#f3a83b;color:var(--navy);margin-left:12px;border:1px solid #f3a83b;}
.btn-sgp:hover{transform:translateY(-2px);box-shadow:0 10px 20px rgba(0,0,0,.18)}
.footer-assoc{font-weight:850;color:#fff;font-size:19px;margin-top:10px}
.footer-tagline{font-size:15px;color:#d9e9f1;margin-top:5px}
.footer-divider{height:1px;background:rgba(255,255,255,.14);margin:20px 0 17px}
.footer-note{font-size:12px;color:#8fb0c3;line-height:1.55}

.navlinks { display: flex; gap: 4px; flex-wrap: nowrap; align-items: center; }
.navlinks button { 
    border: 0; background: transparent; color: #cfe7f7; 
    padding: 8px 11px; border-radius: 10px; cursor: pointer; transition: 0.2s; font-size: 14px; white-space: nowrap;
}
.navlinks button:hover { background: rgba(255,255,255,0.1); color: #fff; }
.navlinks .cta { background: var(--blue); color: #fff; font-weight: 600; }

/* Hero */
.hero { 
    background: radial-gradient(circle at 80% 20%, rgba(75,163,227,0.2), transparent 40%), 
                linear-gradient(135deg, var(--navy), #184A73); 
    color: #fff; 
    padding: 80px 20px;
}
.hero-inner { max-width: 1200px; margin: auto; display: grid; grid-template-columns: 1.1fr 0.9fr; gap: 60px; align-items: center; }
.eyebrow { 
    display: inline-block; padding: 6px 14px; background: rgba(255,255,255,0.1); 
    border: 1px solid rgba(255,255,255,0.2); border-radius: 100px; 
    font-size: 13px; color: #cce8fa; margin-bottom: 20px;
}
.hero h1 { font-size: clamp(32px, 5vw, 64px); line-height: 1.1; margin: 0 0 24px; }
.hero h1 span { color: var(--blue2); }
.hero p { font-size: 1.2rem; color: #d4e7f4; max-width: 600px; margin-bottom: 32px; }

.btn { 
    display: inline-flex; align-items: center; justify-content: center;
    padding: 14px 28px; border-radius: 12px; font-weight: 700; cursor: pointer; transition: 0.3s; border: none;
}
.btn-primary { background: #fff; color: var(--navy); }
.btn-primary:hover { transform: translateY(-2px); box-shadow: 0 10px 20px rgba(0,0,0,0.2); }
.btn-secondary { background: transparent; color: #fff; border: 1px solid rgba(255,255,255,0.3); margin-left: 12px; }

.hero-visual { position: relative; }
.hero-card { 
    background: #fff; border-radius: 24px; padding: 24px; box-shadow: 0 30px 60px rgba(0,0,0,0.3); color: var(--ink);
}
.hero-card img { width: 100%; border-radius: 16px; margin-bottom: 20px; }
.legend-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; }
.legend-btn { 
    padding: 12px; border-radius: 12px; border: 1px solid var(--line); background: #fff; 
    cursor: pointer; font-weight: 700; font-size: 13px; transition: 0.2s;
}
.legend-btn[data-role="implicati"] { border-top: 4px solid var(--blue); }
.legend-btn[data-role="decidenti"] { border-top: 4px solid var(--green); }
.legend-btn[data-role="beneficiari"] { border-top: 4px solid var(--red); }
.legend-btn:hover { background: var(--ice); }

/* Sections */
.section { padding: 100px 20px; }
.section-alt { background: #f0f7ff; }
.container { max-width: 1200px; margin: auto; }
.section-header { text-align: center; max-width: 800px; margin: 0 auto 60px; }
.section-header .tag { 
    background: var(--ice); color: var(--blue); padding: 6px 16px; 
    border-radius: 100px; font-weight: 800; font-size: 12px; text-transform: uppercase;
}
.section-header h2 { font-size: 2.5rem; color: var(--navy); margin: 16px 0; }
.section-header p { font-size: 1.1rem; color: var(--muted); }

/* Features Grid */
.grid-2 { display:grid; grid-template-columns:repeat(2,1fr); gap:24px; }
.grid-3 { display: grid; grid-template-columns: repeat(3, 1fr); gap: 30px; }
.feature-card { 
    background: #fff; padding: 40px; border-radius: 24px; border: 1px solid var(--line); 
    box-shadow: 0 10px 30px rgba(7,28,49,0.04); transition: 0.3s;
}
.feature-card:hover { transform: translateY(-5px); box-shadow: var(--shadow); }
.feature-icon { 
    width: 60px; height: 60px; background: var(--ice); border-radius: 16px; 
    display: flex; align-items: center; justify-content: center; margin-bottom: 24px; font-size: 24px;
}
.feature-card h3 { margin: 0 0 16px; color: var(--navy); }

/* Demo Area */
.demo-container { 
    display: grid; grid-template-columns: 1.1fr 0.9fr; gap: 30px; background: #fff; 
    border-radius: 32px; overflow: hidden; border: 1px solid var(--line); box-shadow: var(--shadow);
}
.alira-panel { display: flex; flex-direction: column; height: 650px; border-right: 1px solid var(--line); }
.panel-top { 
    padding: 20px 30px; background: var(--navy); color: #fff; 
    display: flex; justify-content: space-between; align-items: center;
}
.alira-status { display: flex; align-items: center; gap: 8px; font-size: 13px; color: #9be6c7; }
.status-dot { width: 8px; height: 8px; background: currentColor; border-radius: 50%; animation: pulse 2s infinite; }

.chat-window { flex: 1; overflow-y: auto; padding: 30px; background: #f8fbff; display: flex; flex-direction: column; gap: 16px; }
.message { max-width: 85%; padding: 16px 20px; border-radius: 20px; font-size: 15px; position: relative; animation: fadeIn 0.4s ease-out; }
.msg-alira { background: #fff; border: 1px solid var(--line); border-bottom-left-radius: 4px; color: var(--ink); }
.msg-user { align-self: flex-end; background: var(--blue); color: #fff; border-bottom-right-radius: 4px; }

.quick-replies { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 10px; }
.reply-btn { 
    background: #fff; border: 1px solid var(--blue2); color: var(--blue); 
    padding: 8px 18px; border-radius: 100px; cursor: pointer; transition: 0.2s; font-size: 14px;
}
.reply-btn:hover { background: var(--blue); color: #fff; }

.chat-input { padding: 20px 30px; border-top: 1px solid var(--line); display: flex; gap: 12px; }
.chat-input input { 
    flex: 1; border: 1px solid var(--line); border-radius: 12px; padding: 12px 20px; outline: none; transition: 0.2s;
}
.chat-input input:focus { border-color: var(--blue); box-shadow: 0 0 0 3px rgba(29,115,190,0.1); }
.send-btn { background: var(--blue); color: #fff; border: none; padding: 0 24px; border-radius: 12px; cursor: pointer; font-weight: 600; }

.solon-panel { padding: 40px; background: #fafcfe; display: flex; flex-direction: column; gap: 30px; }
.solon-header { border-bottom: 2px solid var(--ice); padding-bottom: 15px; }
.solon-header h3 { margin: 0; color: var(--navy); display: flex; align-items: center; gap: 10px; }
.solon-header span { font-size: 12px; color: var(--muted); text-transform: uppercase; letter-spacing: 1px; }

.analysis-item { margin-bottom: 20px; }
.analysis-label { display: flex; justify-content: space-between; margin-bottom: 8px; font-size: 14px; }
.analysis-label strong { color: var(--navy); }
.progress-bg { height: 10px; background: var(--ice); border-radius: 100px; overflow: hidden; }
.progress-fill { height: 100%; background: var(--blue); width: 0%; transition: 1s cubic-bezier(0.17, 0.67, 0.83, 0.67); }

.solon-reasoning { 
    background: #fff; border: 1px solid var(--line); border-radius: 16px; padding: 20px; 
    font-size: 14px; color: var(--muted); position: relative; min-height: 100px;
}
.solon-reasoning::before { content: "SOLON Reasoning"; position: absolute; top: -10px; left: 20px; background: var(--navy); color: #fff; padding: 2px 10px; border-radius: 4px; font-size: 10px; font-weight: 700; }

.results-area { display: none; animation: slideUp 0.5s ease-out; }
.results-area.active { display: block; }
.direction-card { 
    background: #fff; border: 1px solid var(--line); border-left: 4px solid var(--blue); 
    padding: 16px; border-radius: 12px; margin-bottom: 12px;
}
.direction-card strong { display: block; color: var(--navy); margin-bottom: 4px; }

/* Footer */
footer { background: var(--navy); color: #fff; padding: 60px 20px; text-align: center; }
.footer-content { max-width: 1200px; margin: auto; }
.footer-logo { display: flex; align-items: center; justify-content: center; gap: 12px; margin-bottom: 20px; }
.footer-logo img { width: 40px; height: 40px; border-radius: 8px; background: #fff; }
.footer-logo span { font-size: 24px; font-weight: 800; }
.footer-text { color: #b9d8ee; max-width: 600px; margin: 0 auto 40px; }
.footer-bottom { border-top: 1px solid rgba(255,255,255,0.1); padding-top: 30px; color: #7890a1; font-size: 14px; }

/* Animations */
@keyframes pulse { 0% { opacity: 1; } 50% { opacity: 0.4; } 100% { opacity: 1; } }
@keyframes fadeIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }
@keyframes slideUp { from { opacity: 0; transform: translateY(20px); } to { opacity: 1; transform: translateY(0); } }

@media (max-width: 960px) {
    .hero-actions { display:flex; flex-wrap:wrap; gap:10px; }
    .hero-actions .btn { margin-left:0; }
    .hero-actions{display:flex;flex-wrap:wrap;gap:10px}.hero-actions .btn{margin-left:0} 
    .hero-inner, .demo-container, .grid-2 { grid-template-columns: 1fr; }
    .grid-3 { grid-template-columns: 1fr; }
    .alira-panel { height: 500px; border-right: none; border-bottom: 1px solid var(--line); }
    .navlinks { display: none; }
}


/* PREJOB v0.3 — roluri, hartă vie, perspectivă partener/investitor */
.role-launcher{position:fixed;right:22px;bottom:22px;z-index:120;background:var(--navy);color:#fff;border:0;border-radius:999px;padding:12px 18px;font-weight:800;box-shadow:var(--shadow);cursor:pointer}
.role-overlay{position:fixed;inset:0;z-index:500;background:rgba(3,15,28,.82);backdrop-filter:blur(10px);display:flex;align-items:center;justify-content:center;padding:24px}
.role-overlay.hidden{display:none}.role-dialog{width:min(980px,100%);background:#fff;border-radius:28px;padding:34px;box-shadow:0 35px 90px rgba(0,0,0,.38)}
.role-dialog h2{margin:0;color:var(--navy);font-size:clamp(28px,4vw,44px)}.role-dialog>p{color:var(--muted);margin:8px 0 26px}.role-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:14px}
.role-card{border:1px solid var(--line);background:#fff;border-radius:18px;padding:20px;text-align:left;cursor:pointer;transition:.22s;min-height:128px}.role-card:hover{transform:translateY(-3px);border-color:var(--blue2);box-shadow:0 12px 30px rgba(7,28,49,.10)}
.role-card strong{display:block;color:var(--navy);font-size:17px;margin:8px 0 4px}.role-card span{font-size:13px;color:var(--muted)}.role-icon{font-size:25px}
.role-current{display:inline-flex;align-items:center;gap:7px;background:rgba(255,255,255,.1);border:1px solid rgba(255,255,255,.17);padding:7px 11px;border-radius:999px;color:#d8ecfa;font-size:12px;margin-left:8px}
.map-stage{position:relative}.map-info{margin-top:15px;padding:16px 18px;border-radius:14px;background:var(--ice);border:1px solid #cbe7f9;min-height:92px}.map-info strong{display:block;color:var(--navy);margin-bottom:4px}.map-info p{margin:0;color:var(--muted);font-size:14px}.legend-btn.active{background:var(--navy);color:#fff;border-color:var(--navy)}
.romania-map{width:100%;min-height:300px;display:grid;place-items:center;padding:8px 4px 16px}.romania-map svg{width:100%;height:auto;display:block}.navlinks{justify-content:flex-end}
.system-flow{display:grid;grid-template-columns:repeat(5,1fr);gap:12px;align-items:stretch;margin-top:34px}.flow-node{background:#fff;border:1px solid var(--line);border-radius:18px;padding:20px;text-align:center;position:relative}.flow-node:not(:last-child)::after{content:'→';position:absolute;right:-20px;top:42%;color:var(--blue);font-weight:900;font-size:22px}.flow-node strong{display:block;color:var(--navy);margin-bottom:5px}.flow-node small{color:var(--muted)}
.investor-grid{display:grid;grid-template-columns:1.05fr .95fr;gap:30px}.impact-panel,.demo-story{background:#fff;border:1px solid var(--line);border-radius:26px;padding:32px;box-shadow:0 12px 35px rgba(7,28,49,.06)}
.kpi-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:14px;margin-top:22px}.kpi{padding:18px;border-radius:16px;background:var(--ice)}.kpi b{display:block;color:var(--navy);font-size:23px}.kpi span{font-size:13px;color:var(--muted)}
.story-step{display:flex;gap:14px;padding:15px 0;border-bottom:1px solid var(--line)}.story-step:last-child{border-bottom:0}.story-no{width:30px;height:30px;flex:0 0 30px;border-radius:50%;display:grid;place-items:center;background:var(--navy);color:#fff;font-weight:800;font-size:12px}.story-step strong{display:block;color:var(--navy)}.story-step p{margin:2px 0 0;color:var(--muted);font-size:14px}
.guided-btn{width:100%;margin-top:18px;background:var(--blue);color:#fff;border:0;border-radius:12px;padding:13px;font-weight:800;cursor:pointer}.role-note{margin:0;padding:12px 16px;background:#fff8e8;border:1px solid #f2d38b;border-radius:12px;color:#72521b;font-size:13px}
@media(max-width:960px){.role-grid{grid-template-columns:repeat(2,1fr)}.system-flow{grid-template-columns:1fr}.flow-node:not(:last-child)::after{content:'↓';right:auto;left:50%;top:auto;bottom:-23px}.investor-grid{grid-template-columns:1fr}}
@media(max-width:560px){.role-grid{grid-template-columns:1fr}.role-dialog{padding:22px}.role-launcher{right:12px;bottom:12px}}


/* DemoPREJOB v0.4 preview — simulare controlată */
.demo-banner{
    position:sticky;top:0;z-index:600;
    background:#fff3cd;color:#73510a;border-bottom:2px solid #f1a936;
    padding:10px 20px;text-align:center;font-size:13px;font-weight:800;
}
.demo-limit{
    margin-top:18px;padding:13px 16px;border-radius:12px;
    background:rgba(255,255,255,.10);border:1px solid rgba(255,255,255,.22);
    color:#dceefa;font-size:13px;
}
.demo-state{
    display:inline-flex;align-items:center;gap:8px;padding:6px 10px;border-radius:999px;
    background:#eaf6ff;color:#1d73be;font-size:12px;font-weight:800;
}
.solon-stages{display:flex;flex-direction:column;gap:10px}
.solon-stage{
    background:#fff;border:1px solid var(--line);border-left:4px solid #9bb9cf;
    border-radius:13px;padding:13px 15px;
}
.solon-stage.active{border-left-color:var(--green);background:#f2fbf7}
.solon-stage strong{display:block;color:var(--navy);font-size:13px;margin-bottom:4px}
.solon-stage span,.solon-stage ul{font-size:13px;color:var(--muted);margin:0}
.solon-stage ul{padding-left:18px}
.codex-box,.piap-box{
    display:none;border-radius:14px;padding:15px;margin-top:5px;font-size:13px;
}
.codex-box.active{display:block;background:#fff8e8;border:1px solid #f2d38b;color:#72521b}
.piap-box.active{display:block;background:#fff0f0;border:1px solid #efb2b2;color:#7a2929}
.demo-result{
    display:none;margin-top:24px;background:#fff;border:1px solid var(--line);
    border-radius:20px;padding:24px;box-shadow:0 12px 30px rgba(7,28,49,.06)
}
.demo-result.active{display:block}
.demo-result h3{margin-top:0;color:var(--navy)}
.demo-result-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:14px}
.demo-result-card{background:#f8fbff;border:1px solid var(--line);border-radius:14px;padding:16px}
.demo-result-card strong{display:block;color:var(--navy);margin-bottom:6px}
.demo-actions{display:flex;gap:10px;flex-wrap:wrap;margin-top:18px}
.demo-actions button{border:0;border-radius:10px;padding:11px 16px;font-weight:800;cursor:pointer}
.demo-actions .again{background:var(--blue);color:#fff}
.demo-actions .roles{background:var(--ice);color:var(--blue)}
.quick-replies.hidden,.chat-input.hidden{display:none}
@media(max-width:700px){.demo-result-grid{grid-template-columns:1fr}}


/* Harta LEGO & Caravana PREJOB */
.harta-caravana-grid{
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:28px;
}
.hc-card{
    background:#fff;
    border:1px solid var(--line);
    border-radius:24px;
    padding:30px;
    box-shadow:0 12px 35px rgba(7,28,49,.06);
}
.hc-card h3{margin:0 0 12px;color:var(--navy)}
.hc-card p{color:var(--muted)}
.hc-steps{display:grid;gap:12px;margin-top:20px}
.hc-step{
    display:flex;gap:12px;align-items:flex-start;
    background:#f8fbff;border:1px solid var(--line);
    border-radius:14px;padding:14px;
}
.hc-step b{
    width:28px;height:28px;flex:0 0 28px;border-radius:50%;
    display:grid;place-items:center;background:var(--navy);
    color:#fff;font-size:12px;
}
.hc-mini-map{
    display:grid;
    grid-template-columns:repeat(3,1fr);
    gap:10px;
    margin-top:20px;
}
.hc-node{
    padding:14px;border-radius:14px;text-align:center;
    font-weight:800;font-size:13px;border:1px solid var(--line);
}
.hc-node.blue{background:#eaf6ff;color:#1d73be}
.hc-node.green{background:#edf9f4;color:#188660}
.hc-node.red{background:#fff0f0;color:#b34343}
.caravana-route{
    margin-top:20px;padding:16px;border-radius:14px;
    background:var(--navy);color:#fff;
}
.caravana-route strong{display:block;margin-bottom:6px}
.caravana-route span{color:#cde4f4;font-size:13px}
.hc-emphasis{
    margin-top:18px;padding:14px 16px;border-left:4px solid var(--gold);
    background:#fff8e8;border-radius:10px;color:#72521b;font-size:14px;
}
@media(max-width:800px){
    .harta-caravana-grid{grid-template-columns:1fr}
    .hc-mini-map{grid-template-columns:1fr}
}


/* Corecție funcționare și afișare pe telefon */
@media (max-width: 700px) {
    .role-overlay {
        align-items: flex-start;
        overflow-y: auto;
        padding: 12px;
    }
    .role-dialog {
        margin: 12px 0;
        max-height: none;
    }
    .role-grid {
        grid-template-columns: 1fr;
    }
    .role-card {
        min-height: auto;
        padding: 16px;
    }
    .hero {
        padding: 38px 14px;
    }
    .hero-inner {
        gap: 28px;
    }
    .hero-actions {
        display: grid;
        gap: 10px;
    }
    .btn-secondary {
        margin-left: 0;
    }
    .map-card,
    .hero-card {
        padding: 18px;
    }
    .legend-grid,
    .map-legend {
        grid-template-columns: 1fr;
    }
    .section {
        padding: 60px 14px;
    }
    .feature-card,
    .hc-card,
    .impact-panel,
    .demo-story {
        padding: 22px;
    }
    .chat-window {
        padding: 18px;
    }
    .solon-panel {
        padding: 22px;
    }
}

</style>
</head>
<body>
<div class="role-overlay" id="roleOverlay">
